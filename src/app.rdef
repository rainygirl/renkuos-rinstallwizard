resource app_signature "application/x-vnd.rainygirl-RInstallWizard";

resource app_name_catalog_entry "x-vnd.rainygirl-RInstallWizard:System name:R InstallWizard";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major	= 1,
	middle	= 0,
	minor	= 0,

	/* 0 = development	1 = alpha		2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety	 = 5,
	internal = 0,

	short_info = "R InstallWizard",
	long_info = "R InstallWizard - install Haiku packages from a file or a "
		"GitHub release, and make packages from dropped programs"
};

// Tracker offers it in "Open with" for packages.
resource file_types message {
	"types" = "application/x-vnd.haiku-package"
};

/*
 * A cardboard package box on the isometric axis the other R apps sit on,
 * taped shut, with a green arrow coming down into it.
 *
 * Do not edit the bytes below. They come from tools/make_icon.py.
 */
